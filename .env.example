# Runtime
MARKETPILOT_ENV=development
MARKETPILOT_AUTH_MODE=local
MARKETPILOT_LOG_LEVEL=INFO
MARKETPILOT_RULES_PATH=config/rules-v1.toml
MARKETPILOT_PROMOTION_CRITERIA_PATH=config/promotion-criteria-v1.toml
MARKETPILOT_CODE_VERSION=development-unpinned
MARKETPILOT_AUDIT_BACKEND=sqlite
MARKETPILOT_AUDIT_DB=data/audit/marketpilot.sqlite3
# Required only when MARKETPILOT_AUDIT_BACKEND=postgresql. Resolve from a local
# secret manager or shell environment; never commit a real DSN.
MARKETPILOT_POSTGRES_DSN=
# Local compose PostgreSQL harness only; use an uncommitted value.
MARKETPILOT_POSTGRES_PASSWORD=
MARKETPILOT_POSTGRES_PORT=55432

# Required together when MARKETPILOT_AUTH_MODE=shared or production. Generate three
# independent values with a CSPRNG or inject them from a secret manager; never commit
# real credentials. Local mode is allowed only with a local/development/test runtime.
MARKETPILOT_READ_ONLY_TOKEN=
MARKETPILOT_OPERATOR_TOKEN=
MARKETPILOT_REVIEWER_TOKEN=

# Optional providers. Keep blank until capability probing is authorized.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
# Explicit dated futures contract only; continuous symbols such as ESmain are rejected.
WEBULL_ES_CONTRACT=
WEBULL_SPXW_EXPIRATION=
WEBULL_SPXW_OPTION_SYMBOL=
DATABENTO_API_KEY=
MASSIVE_API_KEY=
