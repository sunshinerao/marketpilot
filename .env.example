# Runtime
MARKETPILOT_ENV=development
MARKETPILOT_LOG_LEVEL=INFO
MARKETPILOT_CONFIG_VERSION=rules-v1

# PostgreSQL (local compose default; do not commit real credentials)
DATABASE_URL=postgresql://marketpilot:marketpilot@localhost:5432/marketpilot

# Optional providers. Keep blank until capability probing is authorized.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
DATABENTO_API_KEY=
MASSIVE_API_KEY=

